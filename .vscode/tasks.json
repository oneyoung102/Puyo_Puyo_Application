{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build SFML",
            "type": "shell",
            "command": "/usr/bin/clang++",
            "args": [
                "-g",
                "-std=c++17",
                "src/puyoMain.cpp",


                "src/puyoResources/puyoPrinting.cpp",
                "src/puyoResources/puyoFileSystem.cpp",

                "src/puyoResources/printText/puyoPrintText.cpp",
                "src/puyoResources/printText/puyoPrintTextFlash.cpp",
                "src/puyoResources/printText/puyoPrintTextZoom.cpp",

                "src/puyoResources/printObject/puyoPrintObject.cpp",
                "src/puyoResources/printObject/gamePage/puyoPrintScreen.cpp",
                "src/puyoResources/printObject/gamePage/puyoPrintScreenhead.cpp",
                "src/puyoResources/printObject/gamePage/puyoPrintScreenbar.cpp",
                "src/puyoResources/printObject/gamePage/puyoPrintVanishPuyo.cpp",
                "src/puyoResources/printObject/gamePage/puyoPrintGravityPuyo.cpp",
                "src/puyoResources/printObject/gamePage/puyoPrintFuturePuyo.cpp",
                "src/puyoResources/printObject/gamePage/puyoPrintBoard.cpp",
                "src/puyoResources/printObject/gamePage/puyoPrintPlayPuyo.cpp",
                "src/puyoResources/printObject/gamePage/puyoPrintSpawnspot.cpp",
                "src/puyoResources/printObject/gamePage/puyoPrintNextPuyo.cpp",
                "src/puyoResources/printObject/gamePage/puyoPrintScore.cpp",
                "src/puyoResources/printObject/gamePage/puyoPrintObstructViewer.cpp",

                "src/puyoResources/puyoSounding.cpp",


                "src/puyoPage/puyoPageManager.cpp",
                "src/puyoPage/puyoPage.cpp",
                "src/puyoPage/puyoLet.cpp",

                "src/puyoPage/openingPage/puyoOpeningPage.cpp",

                "src/puyoPage/menuPage/puyoMenuPage.cpp",

                "src/puyoPage/readyPage/puyoReadyPage.cpp",

                "src/puyoPage/gamePage/puyoGamePage.cpp",
                "src/puyoPage/gamePage/puyoPhasing.cpp",
                "src/puyoPage/gamePage/puyoBoard.cpp",
                "src/puyoPage/gamePage/puyoPlayer.cpp",
                "src/puyoPage/gamePage/puyoScoreCalc.cpp",
                "src/puyoPage/gamePage/puyoTempPuyo/puyoTempPuyo.cpp",
                "src/puyoPage/gamePage/puyoTempPuyo/puyoGravityPuyo.cpp",
                "src/puyoPage/gamePage/puyoTempPuyo/puyoVanishPuyo.cpp",
                "src/puyoPage/gamePage/puyoTempPuyo/puyoFuturePuyo.cpp",
                "src/puyoPage/gamePage/puyoTempPuyo/puyoAction/puyoPuyoAct_temp.cpp",
                "src/puyoPage/gamePage/puyoTempPuyo/puyoAction/puyoPuyoGravity_temp.cpp",
                "src/puyoPage/gamePage/puyoTempPuyo/puyoAction/puyoPuyoVanish_temp.cpp",
                "src/puyoPage/gamePage/puyoPlayPuyo/puyoPlayPuyo.cpp",
                "src/puyoPage/gamePage/puyoPlayPuyo/puyoAction/puyoPuyoAct.cpp",
                "src/puyoPage/gamePage/puyoPlayPuyo/puyoAction/puyoPuyoLeft.cpp",
                "src/puyoPage/gamePage/puyoPlayPuyo/puyoAction/puyoPuyoRight.cpp",
                "src/puyoPage/gamePage/puyoPlayPuyo/puyoAction/puyoPuyoUp.cpp",
                "src/puyoPage/gamePage/puyoPlayPuyo/puyoAction/puyoPuyoDown.cpp",
                "src/puyoPage/gamePage/puyoPlayPuyo/puyoAction/puyoPuyoTurn.cpp",
                "src/puyoPage/gamePage/puyoPlayPuyo/puyoAction/puyoPuyoDrop.cpp",
                "src/puyoPage/gamePage/puyoPlayPuyo/puyoAction/puyoPuyoGravity.cpp",
                "src/puyoPage/gamePage/puyoPlayPuyo/puyoAction/puyoPuyoStay.cpp",


                "src/puyoPage/endingPage/puyoEndingPage.cpp",


                "-o",
                "${workspaceFolder}/bin/puyo_puyo",
                "-I/opt/homebrew/include",
                "-L/opt/homebrew/lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system",
                "-lsfml-audio"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc 활성 파일 빌드",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "디버거에서 생성된 작업입니다."
        }
    ]
}